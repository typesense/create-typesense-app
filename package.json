{
  "name": "create-typesense-app",
  "version": "0.1.2",
  "description": "Scaffold a working Typesense search-as-you-type app in one command — server, schema, sample data, and a browser-safe search-only API key.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Adiga <nikhiladigaz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typesense/create-typesense-app.git"
  },
  "homepage": "https://github.com/typesense/create-typesense-app#readme",
  "bugs": {
    "url": "https://github.com/typesense/create-typesense-app/issues"
  },
  "bin": {
    "create-typesense-app": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "data"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "typesense",
    "search",
    "instantsearch",
    "typo-tolerance",
    "full-text-search",
    "scaffold",
    "create-app",
    "starter",
    "nextjs",
    "cli",
    "qwik",
    "solidjs",
    "vanilla-js",
    "react",
    "search-ui",
    "typesense-cli",
    "docker",
    "vue",
    "svelte",
    "sveltekit",
    "angular",
    "vite"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "e2e": "node scripts/e2e.mjs",
    "lint": "biome check",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
